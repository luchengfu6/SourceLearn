# Copy this file to .env and fill in the keys you need. Loaded automatically by every run.

# OpenAI (required: backbone, judge and embeddings)
OPENAI_API_KEY=

# Optional: OpenRouter, used for vendor-prefixed model ids such as deepseek/deepseek-v4.1-flash
# OPENROUTER_API_KEY=

# Optional: reasoning effort of the backbone (low / medium / high)
# SOURCELEARN_REASONING_EFFORT=medium
